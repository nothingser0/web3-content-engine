# Web3 Content Pipeline - Environment Configuration Example
# ==========================================================
# Copy this file to .env and fill in your actual values
# This .env.example is safe to commit. The .env file is gitignored.

# ============================================================
# API Configuration (REQUIRED)
# ============================================================
OPENCODE_BASE_URL=http://your-api-host:port/v1
OPENCODE_API_KEY=sk-your-api-key-here

# Standard API configuration aliases
API_BASE_URL=http://your-api-host:port/v1
API_KEY=sk-your-api-key-here

# ============================================================
# Model Configuration (Legacy - kept for backward compatibility)
# ============================================================
MODEL_STRATEGIST=cbcn/deepseek-v4.1-flash
MODEL_WRITER=cx/gpt-6-luna[1m]
MODEL_VISUAL=cbcn/deepseek-v4.1-flash
MODEL_ENGAGEMENT=cbcn/deepseek-v4.1-flash
MODEL_QC=cx/gpt-6-luna[1m]
MODEL_DEFAULT=cx/gpt-6-luna[1m]

# ============================================================
# Model Configuration with Fallback System
# ============================================================
# Each role has: PRIMARY (main) → FB1 (fallback 1) → FB2 (fallback 2)
# System automatically retries with next model if current fails
# Each tier uses a distinct provider for maximum redundancy

# TASK: STRATEGIST (Ideation & Strategy)
# Providers: cbcn → gcli → ds-web
MODEL_STRATEGIST_PRIMARY=cbcn/deepseek-v4.1-flash
MODEL_STRATEGIST_FB1=gcli/grok-4.7
MODEL_STRATEGIST_FB2=ds-web/deepseek-v4-flash
STRATEGIST_MODEL_PRIMARY=cbcn/deepseek-v4.1-flash
STRATEGIST_MODEL_FB1=gcli/grok-4.7
STRATEGIST_MODEL_FB2=ds-web/deepseek-v4-flash

# TASK: WRITER (Content Generation - Voice Critical)
# Providers: cx → ds-web → cbcn
MODEL_WRITER_PRIMARY=cx/gpt-6-luna[1m]
MODEL_WRITER_FB1=ds-web/deepseek-v4-flash
MODEL_WRITER_FB2=cbcn/deepseek-v4.1-flash
WRITER_MODEL_PRIMARY=cx/gpt-6-luna[1m]
WRITER_MODEL_FB1=ds-web/deepseek-v4-flash
WRITER_MODEL_FB2=cbcn/deepseek-v4.1-flash

# TASK: VISUAL (Visual Brief Generation)
# Providers: cbcn → ds-web → oc
MODEL_VISUAL_PRIMARY=cbcn/deepseek-v4.1-flash
MODEL_VISUAL_FB1=ds-web/deepseek-v4-flash
MODEL_VISUAL_FB2=oc/deepseek-v4.1-flash-free
VISUAL_MODEL_PRIMARY=cbcn/deepseek-v4.1-flash
VISUAL_MODEL_FB1=ds-web/deepseek-v4-flash
VISUAL_MODEL_FB2=oc/deepseek-v4.1-flash-free

# TASK: ENGAGEMENT (Engagement Strategy)
# Providers: cbcn → ds-web → groq
MODEL_ENGAGEMENT_PRIMARY=cbcn/deepseek-v4.1-flash
MODEL_ENGAGEMENT_FB1=ds-web/deepseek-v4-flash
MODEL_ENGAGEMENT_FB2=groq/openai/gpt-oss-120b
ENGAGEMENT_MODEL_PRIMARY=cbcn/deepseek-v4.1-flash
ENGAGEMENT_MODEL_FB1=ds-web/deepseek-v4-flash
ENGAGEMENT_MODEL_FB2=groq/openai/gpt-oss-120b

# TASK: QC (Quality Control & Review - Voice Critical)
# Providers: cx → cbcn → ds-web
MODEL_QC_PRIMARY=cx/gpt-6-luna[1m]
MODEL_QC_FB1=cbcn/deepseek-v4.1-flash
MODEL_QC_FB2=ds-web/deepseek-v4-flash
QC_MODEL_PRIMARY=cx/gpt-6-luna[1m]
QC_MODEL_FB1=cbcn/deepseek-v4.1-flash
QC_MODEL_FB2=ds-web/deepseek-v4-flash

# ============================================================
# Emergency Override (Optional - for debugging)
# ============================================================
# Force all services to use a specific model (bypasses routing)
# Uncomment to use:
# WEB3_CONTENT_MODEL_OVERRIDE=your-preferred-model

# ============================================================
# API Timeout Configuration (Optional)
# ============================================================
# Adjust if you're using slow/thinking models
# Default: 600 seconds (10 minutes)
# API_TIMEOUT=600

# ============================================================
# Logging Configuration (Optional)
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# Log file location (optional)
# Default: logs/pipeline.log
# LOG_FILE=logs/pipeline.log

# ============================================================
# Discord Bot Uploads (Optional)
# ============================================================
# Bot token only, with or without "Bot " prefix.
# Needs permission to Send Messages and Attach Files in both channels.
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Channel A receives selected angle.json.
DISCORD_CHANNEL_A_ID=your-channel-a-id
# Channel B receives final FINAL.md package after packaging succeeds.
DISCORD_CHANNEL_B_ID=your-channel-b-id

# ============================================================
# Buffer Integration (Optional)
# ============================================================
# Set false to skip Buffer scheduling entirely.
BUFFER_ENABLED=false

# Buffer API access token for publish requests.
BUFFER_ACCESS_TOKEN=your-buffer-access-token-here

# Buffer profile/channel ID to post into.
BUFFER_PROFILE_ID=your-buffer-profile-id-here

# Enable Discord notify when Buffer publish completes.
BUFFER_DISCORD_NOTIFY=true

# ============================================================
# Docker Scheduler Configuration (Optional)
# ============================================================
# Daily trigger time in 24-hour format (Default: 07:00)
# SCHEDULE_TIME=07:00

# Days to run (1=Monday ... 5=Friday, 7=Sunday)
# SCHEDULE_DAYS=1,2,3,4,5

# Run 1 generation immediately upon container startup
# RUN_ON_START=false
